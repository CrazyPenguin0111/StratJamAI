<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="StratJamAI.Core">
      <HintPath>$(CoreAssemblyPath)</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireCoreAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CoreAssemblyPath)' == '' Or !Exists('$(CoreAssemblyPath)')"
           Text="Pass -p:CoreAssemblyPath=/path/to/StratJamAI.Core.dll. This tool never builds the engine project." />
  </Target>
</Project>
